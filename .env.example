# ---- Slack (api.slack.com/apps) ----
# Bot token: OAuth & Permissions. Scopes: app_mentions:read, chat:write, files:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
# Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
# Channel ID that receives failure alerts (error-notifier-workflow.json)
SLACK_ALERT_CHANNEL=C0123456789
# Local testing only: skips the signature check. Never set this in production.
# SLACK_SKIP_SIGNATURE_CHECK=true

# ---- AI providers ----
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
IDEOGRAM_API_KEY=your-ideogram-api-key-here

# ---- Test mode ----
# true = no OpenAI/Ideogram calls: fake brief, fake 10-post plan, placeholder images, simulated QA. Slack is real.
# Set to false (or delete) once you have real API keys.
TEST_MODE=true
# true = the first QA check fails once on purpose, so you can watch the retry loop
TEST_MODE_QA_FAIL_FIRST=false

# ---- Behaviour ----
# Client used when the request does not name one
DEFAULT_CLIENT_ID=maria_b_study
# Fallback daily image limit per client (a brain can set limits.max_images_per_day)
DAILY_IMAGE_LIMIT=40

# ---- n8n flags (start-n8n.bat / .ps1 already set these) ----
# NODE_FUNCTION_ALLOW_BUILTIN=crypto
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
